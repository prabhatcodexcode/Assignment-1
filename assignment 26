<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Multi Page Student Project</title>

    <style>
        :root {
            --primary: #123b70;
            --secondary: #f28c28;
            --light: #f4f7fb;
            --dark: #222;
            --white: #fff;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: var(--light);
            color: var(--dark);
            line-height: 1.6;
        }

        header {
            background: var(--primary);
            color: var(--white);
            text-align: center;
            padding: 25px;
        }

        nav {
            background: #09284d;
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 10px;
            padding: 12px;
        }

        nav a {
            color: white;
            text-decoration: none;
            padding: 10px 18px;
            border-radius: 5px;
        }

        nav a:hover {
            background: var(--secondary);
        }

        main {
            max-width: 1000px;
            margin: 25px auto;
            padding: 20px;
        }

        .page {
            display: none;
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 3px 10px #0001;
        }

        .page:target {
            display: block;
        }

        body:not(:has(.page:target)) #home {
            display: block;
        }

        h2 {
            color: var(--primary);
            margin-bottom: 15px;
        }

        .card {
            background: var(--light);
            padding: 18px;
            margin: 15px 0;
            border-left: 5px solid var(--secondary);
            border-radius: 5px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        th, td {
            border: 1px solid #ccc;
            padding: 12px;
            text-align: left;
        }

        th {
            background: var(--primary);
            color: white;
        }

        form {
            display: grid;
            gap: 12px;
            max-width: 500px;
        }

        input, textarea, select {
            width: 100%;
            padding: 11px;
            border: 1px solid #bbb;
            border-radius: 5px;
        }

        button {
            background: var(--secondary);
            color: white;
            border: none;
            padding: 12px;
            border-radius: 5px;
            cursor: pointer;
        }

        button:hover {
            background: #d87312;
        }

        footer {
            text-align: center;
            background: var(--primary);
            color: white;
            padding: 18px;
            margin-top: 30px;
        }

        @media (max-width: 600px) {
            main {
                padding: 12px;
            }

            nav {
                flex-direction: column;
                text-align: center;
            }
        }
    </style>
</head>

<body>

<header>
    <h1>Student Portfolio Website</h1>
    <p>Welcome to My Academic Project</p>
</header>

<nav>
    <a href="#home">Home</a>
    <a href="#about">About</a>
    <a href="#register">Register</a>
    <a href="#contact">Contact</a>
</nav>

<main>

    <section id="home" class="page">
