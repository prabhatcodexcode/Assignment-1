<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Design Tokens Assignment by Prabhat Pal">
  <title>Prabhat Pal – Design Tokens with CSS Variables</title>

  <style>
    /* ===== DESIGN TOKENS ===== */
    :root {
      /* Colours */
      --color-primary: #3d5af1;
      --color-primary-dark: #2b3fb5;
      --color-accent: #ff6b6b;
      --color-bg: #f5f7ff;
      --color-surface: #ffffff;
      --color-text: #1f2430;
      --color-muted: #6b7280;

      /* Font sizes */
      --fs-sm: .8rem;
      --fs-base: 1rem;
      --fs-md: 1.25rem;
      --fs-lg: 1.563rem;
      --fs-xl: 1.953rem;
      --fs-2xl: 2.441rem;

      /* Spacing, radius, shadow */
      --space-1: .25rem;
      --space-2: .5rem;
      --space-3: 1rem;
      --space-4: 1.5rem;
      --space-5: 2.5rem;
      --radius: 10px;
      --shadow: 0 4px 14px rgba(31, 36, 48, .12);
      --font-body: system-ui, -apple-system, 'Segoe UI', sans-serif;
    }

    /* ===== DARK THEME ===== */
    [data-theme="dark"] {
      --color-bg: #12141c;
      --color-surface: #1e2230;
      --color-text: #eef0f7;
      --color-muted: #9aa3b5;
    }

    /* ===== BASE ===== */
    body {
      margin: 0;
      padding: var(--space-5);
      font: var(--fs-base)/1.6 var(--font-body);
      background: var(--color-bg);
      color: var(--color-text);
      transition: background .3s;
    }

    h1 {
      font-size: var(--fs-2xl);
      margin: 0 0 var(--space-3);
    }

    h2 {
      font-size: var(--fs-lg);
    }

    small {
      font-size: var(--fs-sm);
      color: var(--color-muted);
    }

    /* ===== COMPONENTS ===== */
    .btn {
      background: var(--color-primary);
      color: #fff;
      border: 0;
      padding: var(--space-2) var(--space-4);
      border-radius: var(--radius);
      font-size: var(--fs-base);
      cursor: pointer;
    }

    .btn:hover {
      background: var(--color-primary-dark);
    }

    .btn--accent {
      background: var(--color-accent);
    }

    .card {
      background: var(--color-surface);
      padding: var(--space-4);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      margin-block: var(--space-4);
    }

    .swatches {
      display: flex;
      gap: var(--space-3);
      flex-wrap: wrap;
    }

    .swatch {
      width: 90px;
      height: 60px;
      border-radius: var(--radius);
      display: grid;
      place-items: end start;
      padding: var(--space-1);
      font-size: var(--fs-sm);
      color: #fff;
    }

    .student-info {
      color: var(--color-muted);
      margin-bottom: var(--space-3);
    }

    footer {
      text-align: center;
      margin-top: var(--space-5);
    }
  </style>
</head>

<body>

  <header>
    <h1>Design Token Sheet</h1>

    <div class="student-info">
      <p><strong>Student Name:</strong> Prabhat Pal</p>
      <p><strong>Course:</strong> BCA Artificial Intelligence</p>
      <p><strong>University:</strong> Invertis University</p>
      <p><strong>Student Code:</strong> bcai2026079</p>
    </div>
  </header>

  <button class="btn"
    onclick="document.documentElement.dataset.theme =
    document.documentElement.dataset.theme === 'dark' ? '' : 'dark'">
    Toggle Dark Theme
  </button>

  <main>

    <div class="card">
      <h2>Colours</h2>

      <div class="swatches">
        <div class="swatch" style="background:var(--color-primary)">
          Primary
        </div>

        <div class="swatch" style="background:var(--color-primary-dark)">
          Dark
        </div>

        <div class="swatch" style="background:var(--color-accent)">
          Accent
        </div>

        <div class="swatch" style="background:var(--color-muted)">
          Muted
        </div>
      </div>
    </div>

    <div class="card">
      <h2>Type Scale</h2>

      <p style="font-size:var(--fs-xl)">
        Extra Large – --fs-xl
      </p>

      <p style="font-size:var(--fs-lg)">
        Large – --fs-lg
      </p>

      <p style="font-size:var(--fs-md)">
        Medium – --fs-md
      </p>

      <p>Base – --fs-base</p>

      <small>Small – --fs-sm</small>
    </div>

    <div class="card">
      <h2>Buttons</h2>

      <button class="btn">Primary</button>

      <button class="btn btn--accent">Accent</button>
    </div>

  </main>

  <footer>
    <small>
      Assignment by Prabhat Pal | BCA AI | Invertis University
      <br>
      © 2026 Prabhat Pal
    </small>
  </footer>

</body>
</html>