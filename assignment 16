
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Prabhat Pal's student registration form">
  <title>Student Registration Form</title>
</head>

<body>
  <h1>Student Registration Form</h1>

  <form action="#" method="post">

    <p>
      <label for="name">Full Name:</label>
      <input type="text" id="name" name="name"
        value="Prabhat Pal" required>
    </p>

    <p>
      <label for="email">Email:</label>
      <input type="email" id="email" name="email"
        value="prabhatpal241@gmail.com" required>
    </p>

    <p>
      <label for="phone">Phone:</label>
      <input type="tel" id="phone" name="phone"
        pattern="[0-9]{10}" value="7318158521"
        placeholder="10 digits" required>
    </p>

    <p>
      <label for="student-code">Student Code:</label>
      <input type="text" id="student-code" name="student-code"
        value="bcai2026079" readonly>
    </p>

    <p>
      <label for="pass">Password:</label>
      <input type="password" id="pass" name="password"
        minlength="8" required>
    </p>

    <fieldset>
      <legend>Gender</legend>
      <label><input type="radio" name="gender" value="male"> Male</label>
      <label><input type="radio" name="gender" value="female"> Female</label>
      <label><input type="radio" name="gender" value="other"> Other</label>
    </fieldset>

    <p>
      <label for="course">Course:</label>
      <select id="course" name="course" required>
        <option value="">-- Select --</option>
        <option value="BCA AI" selected>BCA Artificial Intelligence</option>
        <option value="B.Tech CSE">B.Tech CSE</option>
        <option value="BCA">BCA</option>
        <option value="B.Sc IT">B.Sc IT</option>
      </select>
    </p>

    <p>
      <label for="college">College:</label>
      <input type="text" id="college" name="college"
        value="Invertis University" readonly>
    </p>

    <p>
      <label>
        <input type="checkbox" name="terms" required>
        I agree to the terms and conditions
      </label>
    </p>

    <button type="submit">Register</button>
    <button type="reset">Clear</button>

  </form>
</body>

</html>
